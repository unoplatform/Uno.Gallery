<Page
	x:Class="Uno.Gallery.ExtensionsPatterns.MvuxFeedViewPatternPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Uno.Gallery.ExtensionsPatterns"
	xmlns:reactive="using:Uno.Extensions.Reactive.UI">
	<ScrollViewer>
		<StackPanel Padding="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
			<local:PatternInfoHeader
				PackageName="Uno.Extensions.Reactive.WinUI 7.2.3"
				Requirements="EnableExtensionsPatterns=true. Supported on Desktop, DOM/Skia WebAssembly, Android, and Windows."
				AccessibilityStatus="Named scenario controls, keyboard order, and a polite live status are provided."
				DocumentationUri="https://platform.uno/docs/articles/external/uno.extensions/doc/Learn/Mvux/Overview.html"
				SourceUri="https://github.com/unoplatform/Uno.Gallery/tree/master/Uno.Gallery.ExtensionsPatterns" />
			<TextBlock Text="MVUX FeedView states" Style="{StaticResource TitleTextBlockStyle}" />
			<TextBlock Text="A deterministic local Feed drives FeedView progress, data, none, error, and refresh axes without HTTP." TextWrapping="Wrap" />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="Loading" AutomationProperties.AutomationId="ExtensionsFeed_Loading" Click="Loading_Click" />
				<Button Content="Data" AutomationProperties.AutomationId="ExtensionsFeed_Data" Click="Data_Click" />
				<Button Content="Empty" AutomationProperties.AutomationId="ExtensionsFeed_Empty" Click="Empty_Click" />
				<Button Content="Error" AutomationProperties.AutomationId="ExtensionsFeed_Error" Click="Error_Click" />
				<Button Content="Refresh" AutomationProperties.AutomationId="ExtensionsFeed_Refresh" Click="Refresh_Click" />
				<Button Content="Reset" AutomationProperties.AutomationId="ExtensionsFeed_Reset" Click="Reset_Click" />
			</StackPanel>
			<TextBlock
				x:Name="ScenarioStatus"
				AutomationProperties.AutomationId="ExtensionsFeed_Status"
				AutomationProperties.LiveSetting="Polite"
				Text="Scenario: Data"
				TextWrapping="Wrap" />
			<Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16" MinHeight="180">
				<reactive:FeedView x:Name="FeedHost" None="No local work items." RefreshingState="Loading">
					<reactive:FeedView.ProgressTemplate>
						<DataTemplate>
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
								<ProgressRing IsActive="True" />
								<TextBlock Text="Loading local feed…" />
							</StackPanel>
						</DataTemplate>
					</reactive:FeedView.ProgressTemplate>
					<reactive:FeedView.ErrorTemplate>
						<DataTemplate>
							<TextBlock AutomationProperties.AutomationId="ExtensionsFeed_ErrorContent"
									   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
									   Text="Deterministic offline feed failure."
									   TextWrapping="Wrap" />
						</DataTemplate>
					</reactive:FeedView.ErrorTemplate>
					<reactive:FeedView.ValueTemplate>
						<DataTemplate>
							<StackPanel Spacing="8">
								<TextBlock Text="{Binding Data.Heading}" FontWeight="SemiBold" />
								<ItemsControl ItemsSource="{Binding Data.Items}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,4">
												<TextBlock Text="{Binding Name}" />
												<TextBlock Text="{Binding Detail}" Opacity="0.7" />
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</DataTemplate>
					</reactive:FeedView.ValueTemplate>
				</reactive:FeedView>
			</Border>
		</StackPanel>
	</ScrollViewer>
</Page>
