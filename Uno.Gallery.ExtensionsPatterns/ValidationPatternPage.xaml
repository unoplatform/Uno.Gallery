<Page
	x:Class="Uno.Gallery.ExtensionsPatterns.ValidationPatternPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Uno.Gallery.ExtensionsPatterns">
	<ScrollViewer>
		<StackPanel Padding="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
			<local:PatternInfoHeader
				PackageName="Uno.Extensions.Validation 7.2.3"
				Requirements="EnableExtensionsPatterns=true. The page-local validator uses DataAnnotations; no server roundtrip."
				AccessibilityStatus="Every field has a header, errors are summarized in a polite live region, and focus order follows the form."
				DocumentationUri="https://platform.uno/docs/articles/external/uno.extensions/doc/Learn/Validation/ValidationOverview.html"
				SourceUri="https://github.com/unoplatform/Uno.Gallery/tree/master/Uno.Gallery.ExtensionsPatterns" />
			<TextBlock Text="Validation" Style="{StaticResource TitleTextBlockStyle}" />
			<TextBlock Text="Uno.Extensions.Validation runs required, length, email, and range rules against a small local form." TextWrapping="Wrap" />
			<TextBox x:Name="NameInput" Header="Name" AutomationProperties.AutomationId="ExtensionsValidation_Name" />
			<TextBox x:Name="EmailInput" Header="Email" AutomationProperties.AutomationId="ExtensionsValidation_Email" InputScope="EmailSmtpAddress" />
			<NumberBox x:Name="AgeInput" Header="Age" AutomationProperties.AutomationId="ExtensionsValidation_Age" Minimum="0" Maximum="150" Value="18" />
			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Content="Validate" AutomationProperties.AutomationId="ExtensionsValidation_Validate" Click="Validate_Click" />
				<Button Content="Valid example" AutomationProperties.AutomationId="ExtensionsValidation_ValidVariant" Click="ValidVariant_Click" />
				<Button Content="Reset" AutomationProperties.AutomationId="ExtensionsValidation_Reset" Click="Reset_Click" />
			</StackPanel>
			<TextBlock
				x:Name="ValidationStatus"
				AutomationProperties.AutomationId="ExtensionsValidation_Status"
				AutomationProperties.LiveSetting="Polite"
				Text="Form has not been validated."
				TextWrapping="Wrap" />
		</StackPanel>
	</ScrollViewer>
</Page>
