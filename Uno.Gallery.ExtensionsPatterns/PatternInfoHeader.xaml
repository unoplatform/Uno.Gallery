<UserControl
	x:Class="Uno.Gallery.ExtensionsPatterns.PatternInfoHeader"
	x:Name="Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel Spacing="10">
		<StackPanel Orientation="Horizontal" Spacing="8">
			<Border Padding="8,4" CornerRadius="12" Background="{ThemeResource AccentFillColorSecondaryBrush}">
				<TextBlock Text="Optional flavor" />
			</Border>
			<Border Padding="8,4" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
				<TextBlock Text="Offline" />
			</Border>
			<Border Padding="8,4" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
				<TextBlock Text="{Binding PackageName, ElementName=Root}" />
			</Border>
		</StackPanel>
		<TextBlock Text="{Binding Requirements, ElementName=Root}" TextWrapping="Wrap" />
		<TextBlock
			AutomationProperties.Name="Accessibility status"
			Text="{Binding AccessibilityStatus, ElementName=Root}"
			TextWrapping="Wrap" />
		<StackPanel Orientation="Horizontal" Spacing="8">
			<HyperlinkButton Content="Documentation" NavigateUri="{Binding DocumentationUri, ElementName=Root}" />
			<HyperlinkButton Content="Source" NavigateUri="{Binding SourceUri, ElementName=Root}" />
		</StackPanel>
	</StackPanel>
</UserControl>
