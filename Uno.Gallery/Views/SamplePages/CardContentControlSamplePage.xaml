<Page x:Class="Uno.Gallery.Views.Samples.CardContentControlSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.Gallery"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:smtx="using:ShowMeTheXAML"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  mc:Ignorable="d">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<local:SamplePageLayout x:Name="SamplePageLayoutRoot">
			<local:SamplePageLayout.MaterialTemplate>
				<DataTemplate>
					<smtx:XamlDisplay UniqueKey="CardContentControl_Interactive"
									  smtx:XamlDisplayExtensions.Header="Interactive custom-content card"
									  smtx:XamlDisplayExtensions.Description="CardContentControl provides a flexible content surface with toolkit elevation, shadow color, and clickable interaction states."
									  smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
						<StackPanel Spacing="12">
							<utu:CardContentControl x:Name="InteractiveCard"
													AutomationProperties.AutomationId="CardContentControl_Card"
													AutomationProperties.Name="Toolkit extension summary card"
													AutomationProperties.HelpText="A clickable card with configurable elevation and shadow color"
													Style="{StaticResource ElevatedCardContentControlStyle}"
													Elevation="8"
													ShadowColor="DarkSlateBlue"
													IsClickable="True"
													Tapped="InteractiveCard_Tapped"
													MaxWidth="420"
													HorizontalAlignment="Left">
								<StackPanel Padding="20" Spacing="8">
									<TextBlock Text="Flexible card content" Style="{StaticResource TitleMedium}" />
									<TextBlock Text="This content is not constrained to Card header, media, or action slots."
											   TextWrapping="WrapWholeWords"
											   Style="{StaticResource BodyMedium}" />
								</StackPanel>
							</utu:CardContentControl>

							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button AutomationProperties.AutomationId="CardContentControl_Reset"
										AutomationProperties.Name="Reset card configuration"
										Content="Reset"
										Click="Reset_Click" />
								<Button AutomationProperties.AutomationId="CardContentControl_ToggleConfiguration"
										AutomationProperties.Name="Toggle card configuration"
										Content="Toggle configuration"
										Click="ToggleConfiguration_Click" />
								<Button AutomationProperties.AutomationId="CardContentControl_Activate"
										AutomationProperties.Name="Activate card"
										Content="Activate"
										Click="Activate_Click" />
							</StackPanel>

							<TextBlock x:Name="CardStatus"
									   AutomationProperties.AutomationId="CardContentControl_Status"
									   AutomationProperties.LiveSetting="Polite"
									   Text="Elevation: 8; Shadow: #FF483D8B; Clickable: True; activations: 0"
									   Style="{StaticResource BodyMedium}" />
						</StackPanel>
					</smtx:XamlDisplay>
				</DataTemplate>
			</local:SamplePageLayout.MaterialTemplate>
		</local:SamplePageLayout>
	</Grid>
</Page>
