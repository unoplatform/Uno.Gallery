<Page x:Class="Uno.Gallery.Views.Samples.DesignTokensSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.Gallery"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:smtx="using:ShowMeTheXAML"
	  mc:Ignorable="d">

	<Page.Resources>
		<Style x:Key="TokenLabelStyle"
			   TargetType="TextBlock"
			   BasedOn="{StaticResource BodyMedium}">
			<Setter Property="VerticalAlignment"
					Value="Center" />
		</Style>
		<Style x:Key="TokenValueStyle"
			   TargetType="TextBlock"
			   BasedOn="{StaticResource BodyMedium}">
			<Setter Property="FontFamily"
					Value="Consolas, Courier New, monospace" />
			<Setter Property="Foreground"
					Value="{ThemeResource OnSurfaceVariantBrush}" />
			<Setter Property="VerticalAlignment"
					Value="Center" />
		</Style>
		<Style x:Key="SectionHeaderStyle"
			   TargetType="TextBlock"
			   BasedOn="{StaticResource TitleSmall}">
			<Setter Property="Margin"
					Value="0,16,0,4" />
		</Style>
	</Page.Resources>

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<local:SamplePageLayout>
			<local:SamplePageLayout.MaterialTemplate>
				<DataTemplate>
					<smtx:XamlDisplay UniqueKey="DesignTokensSamplePage_Material"
									  smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\XX">
						<StackPanel Spacing="4"
									Padding="0,8,0,24">

							<TextBlock Style="{StaticResource BodyMedium}"
									   TextWrapping="WrapWholeWords"
									   Text="Design tokens are the smallest building blocks of the Material theme — spacing, shape, and density values resolved at construction time from BaseTheme configuration." />

							<!-- DENSITY -->
							<TextBlock Text="Density"
									   AutomationProperties.AutomationId="Section_Density"
									   Style="{StaticResource SectionHeaderStyle}" />
							<TextBlock Style="{StaticResource BodySmall}"
									   Foreground="{ThemeResource OnSurfaceVariantBrush}"
									   TextWrapping="WrapWholeWords"
									   Text="Density is set on MaterialToolkitTheme (DefaultDensity). The base spacing unit drives all Space* tokens. Control heights and icon sizes remain fixed." />

							<Border AutomationProperties.AutomationId="DensityInfoCard"
									Background="{ThemeResource SurfaceVariantBrush}"
									CornerRadius="8"
									Padding="12">
								<Grid ColumnSpacing="16"
									  RowSpacing="6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<TextBlock Grid.Row="0" Grid.Column="0"
											   Style="{StaticResource LabelMedium}"
											   Text="Preset" />
									<TextBlock Grid.Row="0" Grid.Column="1"
											   Style="{StaticResource LabelMedium}"
											   Text="Base unit" />
									<TextBlock Grid.Row="0" Grid.Column="2"
											   Style="{StaticResource LabelMedium}"
											   Text="Space400" />
									<TextBlock Grid.Row="0" Grid.Column="3"
											   Style="{StaticResource LabelMedium}"
											   Text="Notes" />
									<TextBlock Grid.Row="1" Grid.Column="0"
											   AutomationProperties.AutomationId="Token_Density_Compact"
											   Style="{StaticResource TokenLabelStyle}"
											   Text="Compact" />
									<TextBlock Grid.Row="1" Grid.Column="1"
											   Style="{StaticResource TokenValueStyle}"
											   Text="3 px" />
									<TextBlock Grid.Row="1" Grid.Column="2"
											   Style="{StaticResource TokenValueStyle}"
											   Text="12 px" />
									<TextBlock Grid.Row="1" Grid.Column="3"
											   Style="{StaticResource BodySmall}"
											   Foreground="{ThemeResource OnSurfaceVariantBrush}"
											   VerticalAlignment="Center"
											   Text="Data-dense UIs" />
									<TextBlock Grid.Row="2" Grid.Column="0"
											   AutomationProperties.AutomationId="Token_Density_Regular"
											   Style="{StaticResource TokenLabelStyle}"
											   Text="Regular (default)" />
									<TextBlock Grid.Row="2" Grid.Column="1"
											   Style="{StaticResource TokenValueStyle}"
											   Text="4 px" />
									<TextBlock Grid.Row="2" Grid.Column="2"
											   Style="{StaticResource TokenValueStyle}"
											   Text="16 px" />
									<TextBlock Grid.Row="2" Grid.Column="3"
											   Style="{StaticResource BodySmall}"
											   Foreground="{ThemeResource OnSurfaceVariantBrush}"
											   VerticalAlignment="Center"
											   Text="Balanced spacing" />
									<TextBlock Grid.Row="3" Grid.Column="0"
											   AutomationProperties.AutomationId="Token_Density_Comfy"
											   Style="{StaticResource TokenLabelStyle}"
											   Text="Comfy" />
									<TextBlock Grid.Row="3" Grid.Column="1"
											   Style="{StaticResource TokenValueStyle}"
											   Text="5 px" />
									<TextBlock Grid.Row="3" Grid.Column="2"
											   Style="{StaticResource TokenValueStyle}"
											   Text="20 px" />
									<TextBlock Grid.Row="3" Grid.Column="3"
											   Style="{StaticResource BodySmall}"
											   Foreground="{ThemeResource OnSurfaceVariantBrush}"
											   VerticalAlignment="Center"
											   Text="Generous touch targets" />
								</Grid>
							</Border>

							<Border Background="{ThemeResource SurfaceBrush}"
									BorderBrush="{ThemeResource OutlineBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="12"
									Margin="0,4,0,0">
								<StackPanel Orientation="Horizontal"
											Spacing="8">
									<TextBlock Style="{StaticResource BodyMedium}"
											   VerticalAlignment="Center"
											   Text="Active density:" />
									<TextBlock AutomationProperties.AutomationId="ActiveDensityText"
											   Style="{StaticResource BodyMedium}"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center"
											   Text="{Binding Data.ActiveDensityLabel}" />
									<TextBlock AutomationProperties.AutomationId="ActiveBaseUnitText"
											   Style="{StaticResource TokenValueStyle}"
											   VerticalAlignment="Center"
											   Text="{Binding Data.ActiveBaseUnitLabel}" />
								</StackPanel>
							</Border>

							<!-- SPACING TOKENS -->
							<TextBlock Text="Spacing Tokens (Space*)"
									   AutomationProperties.AutomationId="Section_Spacing"
									   Style="{StaticResource SectionHeaderStyle}" />
							<TextBlock Style="{StaticResource BodySmall}"
									   Foreground="{ThemeResource OnSurfaceVariantBrush}"
									   TextWrapping="WrapWholeWords"
									   Text="Space tokens are derived from the base density unit. Space200 = 2x base, Space400 = 4x base, etc." />

							<ItemsControl AutomationProperties.AutomationId="SpacingTokensList"
										  ItemsSource="{Binding Data.SpacingTokens}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnSpacing="16"
											  Margin="0,3">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="120" />
												<ColumnDefinition Width="64" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0"
													   Text="{Binding Name}"
													   AutomationProperties.AutomationId="{Binding AutomationId}"
													   Style="{StaticResource TokenLabelStyle}" />
											<TextBlock Grid.Column="1"
													   Text="{Binding ValueText}"
													   Style="{StaticResource TokenValueStyle}" />
											<Border Grid.Column="2"
													Background="{ThemeResource PrimaryBrush}"
													Height="6"
													CornerRadius="3"
													VerticalAlignment="Center"
													Width="{Binding BarWidth}"
													HorizontalAlignment="Left" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- SHAPE TOKENS -->
							<TextBlock Text="Shape Tokens (Radius*)"
									   AutomationProperties.AutomationId="Section_Shape"
									   Style="{StaticResource SectionHeaderStyle}" />
							<TextBlock Style="{StaticResource BodySmall}"
									   Foreground="{ThemeResource OnSurfaceVariantBrush}"
									   TextWrapping="WrapWholeWords"
									   Text="Shape tokens derive from DefaultCornerRadius (default 4 px). Radius200 = 2x base, Radius400 = 4x base. RadiusFull = 9999 (pill)." />

							<ItemsControl AutomationProperties.AutomationId="ShapeTokensList"
										  ItemsSource="{Binding Data.ShapeTokens}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnSpacing="16"
											  Margin="0,4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="120" />
												<ColumnDefinition Width="64" />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0"
													   Text="{Binding Name}"
													   AutomationProperties.AutomationId="{Binding AutomationId}"
													   Style="{StaticResource TokenLabelStyle}" />
											<TextBlock Grid.Column="1"
													   Text="{Binding ValueText}"
													   Style="{StaticResource TokenValueStyle}" />
											<Border Grid.Column="2"
													Background="{ThemeResource SecondaryContainerBrush}"
													Height="24"
													Width="80"
													CornerRadius="{Binding CornerRadiusPreview}"
													HorizontalAlignment="Left" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- TYPOGRAPHY TOKENS -->
							<TextBlock Text="Typography Scale"
									   AutomationProperties.AutomationId="Section_Typography"
									   Style="{StaticResource SectionHeaderStyle}" />
							<TextBlock Style="{StaticResource BodySmall}"
									   Foreground="{ThemeResource OnSurfaceVariantBrush}"
									   TextWrapping="WrapWholeWords"
									   Text="Material type-scale styles from Uno.Themes. Apply as StaticResource to any TextBlock." />

							<StackPanel Spacing="6"
										AutomationProperties.AutomationId="TypographyTokensList">
								<TextBlock AutomationProperties.AutomationId="Token_DisplayLarge"
										   Style="{StaticResource DisplayLarge}"
										   Text="Display Large (57/64)" />
								<TextBlock AutomationProperties.AutomationId="Token_HeadlineMedium"
										   Style="{StaticResource HeadlineMedium}"
										   Text="Headline Medium (28/36)" />
								<TextBlock AutomationProperties.AutomationId="Token_TitleMedium"
										   Style="{StaticResource TitleMedium}"
										   Text="Title Medium (16/24)" />
								<TextBlock AutomationProperties.AutomationId="Token_BodyLarge"
										   Style="{StaticResource BodyLarge}"
										   Text="Body Large (16/24)" />
								<TextBlock AutomationProperties.AutomationId="Token_BodyMedium"
										   Style="{StaticResource BodyMedium}"
										   Text="Body Medium (14/20)" />
								<TextBlock AutomationProperties.AutomationId="Token_LabelSmall"
										   Style="{StaticResource LabelSmall}"
										   Text="Label Small (11/16)" />
							</StackPanel>

						</StackPanel>
					</smtx:XamlDisplay>
				</DataTemplate>
			</local:SamplePageLayout.MaterialTemplate>
		</local:SamplePageLayout>
	</Grid>
</Page>