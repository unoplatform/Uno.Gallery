<Page x:Class="Uno.Gallery.Views.Samples.AnimatedVisualPlayerSamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Uno.Gallery"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:smtx="using:ShowMeTheXAML"
      xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
      mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <local:SamplePageLayout x:Name="SamplePageLayoutRoot" IsDesignAgnostic="True">
            <local:SamplePageLayout.DesignAgnosticTemplate>
                <DataTemplate>
                    <StackPanel Spacing="12">

                        <!-- AnimatedVisualPlayer: manual play/stop -->
                        <smtx:XamlDisplay UniqueKey="AnimatedVisualPlayer_PlayStop"
                                          smtx:XamlDisplayExtensions.Header="AnimatedVisualPlayer — play/stop"
                                          smtx:XamlDisplayExtensions.Description="Tap the button to play the animation once via PlayAsync. The status label reflects the transition from Stopped → Playing → Stopped."
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <Button AutomationProperties.AutomationId="AnimatedVisualPlayer_PlayBtn"
                                        Click="OnPlayAnimationClick">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <AnimatedVisualPlayer x:Name="AnimPlayer"
                                                              AutomationProperties.AutomationId="AnimatedVisualPlayer_Player"
                                                              Width="24"
                                                              Height="24"
                                                              AutoPlay="False">
                                            <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Animations/loading_animation_data.json" />
                                        </AnimatedVisualPlayer>
                                        <TextBlock Text="Play animation"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="AnimationStatusText"
                                           AutomationProperties.AutomationId="AnimatedVisualPlayer_Status"
                                           Text="Status: Stopped"
                                           Style="{StaticResource BodyMedium}" />
                                <TextBlock x:Name="AnimPlayCount"
                                           AutomationProperties.AutomationId="AnimatedVisualPlayer_PlayCount"
                                           Text="Completed plays: 0"
                                           Style="{StaticResource BodySmall}" />
                            </StackPanel>
                        </smtx:XamlDisplay>

                        <!-- AnimatedVisualPlayer: auto-play loop -->
                        <smtx:XamlDisplay UniqueKey="AnimatedVisualPlayer_AutoPlay"
                                          smtx:XamlDisplayExtensions.Header="AnimatedVisualPlayer — auto-play"
                                          smtx:XamlDisplayExtensions.Description="Set AutoPlay=True to start playback immediately. The player loops indefinitely until stopped programmatically."
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <AnimatedVisualPlayer AutomationProperties.AutomationId="AnimatedVisualPlayer_AutoPlay"
                                                      Width="80"
                                                      Height="80"
                                                      AutoPlay="True"
                                                      HorizontalAlignment="Left">
                                    <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Animations/loading_animation_data.json" />
                                </AnimatedVisualPlayer>
                                <TextBlock TextWrapping="WrapWholeWords"
                                           MaxWidth="420"
                                           Style="{StaticResource BodySmall}">
                                    The animation source is a Lottie JSON file rendered by CommunityToolkit.WinUI.Lottie.
                                    AnimatedIcon builds on AnimatedVisualPlayer to add state-driven transitions.
                                </TextBlock>
                            </StackPanel>
                        </smtx:XamlDisplay>

                    </StackPanel>
                </DataTemplate>
            </local:SamplePageLayout.DesignAgnosticTemplate>
        </local:SamplePageLayout>
    </Grid>
</Page>
