<Page x:Class="Uno.Gallery.Views.Samples.AnimatedIconSamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Uno.Gallery"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:smtx="using:ShowMeTheXAML"
      xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
      mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <local:SamplePageLayout IsDesignAgnostic="True">
            <local:SamplePageLayout.DesignAgnosticTemplate>
                <DataTemplate>
                    <StackPanel Spacing="12">

                        <!-- AnimatedIcon: concept + state machine -->
                        <smtx:XamlDisplay UniqueKey="AnimatedIcon_StateTransition"
                                          smtx:XamlDisplayExtensions.Header="AnimatedIcon — state transitions"
                                          smtx:XamlDisplayExtensions.Description="AnimatedIcon plays motion in response to UI state changes. Hover and press the button to trigger state transitions."
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <!-- AnimatedIcon wraps an IAnimatedVisualSource2 and reacts to
                                     AnimatedIcon.State attached-property changes.
                                     Without a LottieGen-generated source, we show AnimatedVisualPlayer
                                     as the underlying animation primitive. -->
                                <Button AutomationProperties.AutomationId="AnimatedIcon_PlayBtn"
                                        Click="OnPlayAnimationClick">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <AnimatedVisualPlayer x:Name="AnimPlayer"
                                                              AutomationProperties.AutomationId="AnimatedIcon_Player"
                                                              Width="24"
                                                              Height="24"
                                                              AutoPlay="False">
                                            <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Animations/loading_animation_data.json" />
                                        </AnimatedVisualPlayer>
                                        <TextBlock Text="Play animation"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="AnimationStatusText"
                                           AutomationProperties.AutomationId="AnimatedIcon_Status"
                                           Text="Status: Stopped"
                                           Style="{StaticResource BodyMedium}" />
                            </StackPanel>
                        </smtx:XamlDisplay>

                        <!-- AnimatedVisualPlayer: auto-play loop -->
                        <smtx:XamlDisplay UniqueKey="AnimatedIcon_AutoPlay"
                                          smtx:XamlDisplayExtensions.Header="AnimatedVisualPlayer — auto-play"
                                          smtx:XamlDisplayExtensions.Description="AnimatedVisualPlayer renders an IAnimatedVisualSource. AnimatedIcon uses the same source interface but adds state-driven playback."
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <AnimatedVisualPlayer AutomationProperties.AutomationId="AnimatedIcon_AutoPlay"
                                                      Width="80"
                                                      Height="80"
                                                      AutoPlay="True"
                                                      HorizontalAlignment="Left">
                                    <lottie:LottieVisualSource UriSource="ms-appx:///Assets/Animations/loading_animation_data.json" />
                                </AnimatedVisualPlayer>
                                <TextBlock TextWrapping="WrapWholeWords"
                                           MaxWidth="420"
                                           Style="{StaticResource BodySmall}">
                                    Note: Production AnimatedIcon samples require an IAnimatedVisualSource2
                                    generated by the LottieGen tool from a Lottie JSON file.
                                    See the documentation link for details.
                                </TextBlock>
                            </StackPanel>
                        </smtx:XamlDisplay>

                    </StackPanel>
                </DataTemplate>
            </local:SamplePageLayout.DesignAgnosticTemplate>
        </local:SamplePageLayout>
    </Grid>
</Page>
