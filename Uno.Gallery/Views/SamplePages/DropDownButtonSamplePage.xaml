<Page x:Class="Uno.Gallery.Views.Samples.DropDownButtonSamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Uno.Gallery"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:smtx="using:ShowMeTheXAML"
      mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <local:SamplePageLayout>
            <local:SamplePageLayout.FluentTemplate>
                <DataTemplate>
                    <StackPanel Spacing="12">

                        <!-- Default DropDownButton -->
                        <smtx:XamlDisplay UniqueKey="DropDownButton_Fluent_Default"
                                          smtx:XamlDisplayExtensions.Header="DropDownButton"
                                          smtx:XamlDisplayExtensions.Description="A button that shows a chevron to indicate it opens a flyout. Unlike SplitButton, the entire button area opens the flyout."
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <DropDownButton AutomationProperties.AutomationId="DropDownButton_Default"
                                                Content="Sort by">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Name"
                                                            AutomationProperties.AutomationId="DropDownButton_FlyoutItem_Name" />
                                            <MenuFlyoutItem Text="Date modified" />
                                            <MenuFlyoutItem Text="Size" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Ascending" />
                                            <MenuFlyoutItem Text="Descending" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </smtx:XamlDisplay>

                        <!-- DropDownButton with icon -->
                        <smtx:XamlDisplay UniqueKey="DropDownButton_Fluent_WithIcon"
                                          smtx:XamlDisplayExtensions.Header="DropDownButton with icon"
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <DropDownButton AutomationProperties.AutomationId="DropDownButton_WithIcon">
                                    <DropDownButton.Content>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <SymbolIcon Symbol="Share" />
                                            <TextBlock Text="Share" />
                                        </StackPanel>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Copy link" />
                                            <MenuFlyoutItem Text="Send via email" />
                                            <MenuFlyoutItem Text="Post to feed" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </smtx:XamlDisplay>

                        <!-- Disabled DropDownButton -->
                        <smtx:XamlDisplay UniqueKey="DropDownButton_Fluent_Disabled"
                                          smtx:XamlDisplayExtensions.Header="DropDownButton — Disabled"
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <DropDownButton AutomationProperties.AutomationId="DropDownButton_Disabled"
                                                Content="Export"
                                                IsEnabled="False">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem AutomationProperties.AutomationId="DropDownButton_Disabled_FlyoutItem_PDF"
                                                            Text="PDF" />
                                            <MenuFlyoutItem Text="CSV" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </smtx:XamlDisplay>

                    </StackPanel>
                </DataTemplate>
            </local:SamplePageLayout.FluentTemplate>
        </local:SamplePageLayout>
    </Grid>
</Page>
