<Page
	x:Class="Uno.Gallery.Views.Samples.CanarySamplePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Uno.Gallery"
	xmlns:samples="using:Uno.Gallery.Views.Samples"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<local:SamplePageLayout IsDesignAgnostic="True">
			<local:SamplePageLayout.DesignAgnosticTemplate>
				<DataTemplate>
					<StackPanel>
						<Button x:Name="NavigateAllPagesButton"
								Content="Navigate to all pages"
								Loaded="NavigateAllPagesButton_Loaded"
								Click="NavigateAllPages_Click" />

						<TextBlock Text="Rendering and platform"
								   FontSize="20"
								   Margin="0,20,0,0" />
						<TextBlock Loaded="BuildDiagnostics_Loaded"
								   TextWrapping="Wrap"
								   AutomationProperties.AutomationId="Diagnostics_BuildInfo"
								   AutomationProperties.Name="Rendering and platform build diagnostics" />

						<TextBlock Text="Performance Marks"
								   FontSize="20"
								   Margin="0,20,0,0" />
						<Button Content="Refresh"
								Click="RefreshMarks_Click"
								AutomationProperties.AutomationId="PerfMarks_RefreshButton" />
						<TextBox Loaded="PerfMarksTextBox_Loaded"
								 IsReadOnly="True"
								 AcceptsReturn="True"
								 TextWrapping="Wrap"
								 FontFamily="Courier New"
								 MinHeight="100"
								 Margin="0,4,0,0"
								 AutomationProperties.AutomationId="PerfMarksOutput" />

						<TextBlock Text="Loaded assemblies"
								   FontSize="20"
								   Margin="0,20,0,0" />

						<ItemsControl Loaded="AssembliesList_Loaded">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="samples:AssemblyInfoItem">
									<StackPanel>
										<TextBlock Text="{x:Bind Name}"
												   FontFamily="Courier New" />
										<TextBlock Margin="20,0,0,0"
												   FontFamily="Courier New"
												   Text="{x:Bind Version}" />
										<TextBlock Margin="20,0,0,0"
												   FontFamily="Courier New"
												   Text="{x:Bind DisplayVersion}" />
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</DataTemplate>
			</local:SamplePageLayout.DesignAgnosticTemplate>
		</local:SamplePageLayout>
	</Grid>
</Page>
