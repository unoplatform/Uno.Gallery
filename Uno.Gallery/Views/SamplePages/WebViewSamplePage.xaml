<Page x:Class="Uno.Gallery.Views.Samples.WebViewSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="using:Uno.Gallery"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:smtx="using:ShowMeTheXAML"
	  xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:not_win="http://uno.ui/not_win"
	  mc:Ignorable="d not_win">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<local:SamplePageLayout x:Name="LocalSamplePageLayout">

			<local:SamplePageLayout.FluentTemplate>
				<DataTemplate>
					<Grid>
						<Grid>

							<!-- WebView -->
							<smtx:XamlDisplay UniqueKey="WebViewSamplePage_WebView_Win"
											  smtx:XamlDisplayExtensions.Header="WebView">
								<StackPanel Spacing="8">
									<WebView2 Loaded="WebView_Loaded"
											  NavigationCompleted="WebView_NavigationCompleted"
											  Height="400"
											  AutomationProperties.Name="Self-contained WebView content" />
									<TextBlock x:Name="WebViewStatus"
											   Text="WebView has not initialized."
											   AutomationProperties.AutomationId="WebView_Status"
											   AutomationProperties.LiveSetting="Polite"
											   AutomationProperties.Name="WebView status" />
								</StackPanel>
							</smtx:XamlDisplay>

						</Grid>
					</Grid>
				</DataTemplate>
			</local:SamplePageLayout.FluentTemplate>
		</local:SamplePageLayout>
	</Grid>
</Page>
