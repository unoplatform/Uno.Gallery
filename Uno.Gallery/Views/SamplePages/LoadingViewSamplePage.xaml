<!-- Adapted from unoplatform/uno.toolkit.ui samples/Uno.Toolkit.Samples/Content/Controls/LoadingViewSample.xaml (MIT) -->
<Page x:Class="Uno.Gallery.Views.SamplePages.LoadingViewSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:local="using:Uno.Gallery"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:smtx="using:ShowMeTheXAML"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	  mc:Ignorable="d">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<local:SamplePageLayout x:Name="SamplePageLayout"
								IsDesignAgnostic="True">
			<local:SamplePageLayout.DesignAgnosticTemplate>
				<DataTemplate>
					<ScrollViewer HorizontalScrollMode="Disabled">
						<StackPanel Padding="0,20"
									Spacing="20">

							<!-- Basic LoadingView with Source -->
							<smtx:XamlDisplay UniqueKey="LoadingViewSamplePage_Basic"
											  smtx:XamlDisplayExtensions.Header="LoadingView with ILoadable source">
								<StackPanel Spacing="12">
									<utu:LoadingView x:Name="BasicLoadingView"
												 AutomationProperties.AutomationId="LoadingView_Basic"
													 LoadingContent="Fetching data…">
										<utu:LoadingView.Source>
											<utu:CompositeLoadableSource>
												<utu:LoadableSource Source="{Binding Data.LoadCommand}" />
											</utu:CompositeLoadableSource>
										</utu:LoadingView.Source>

										<utu:LoadingView.LoadingContentTemplate>
											<DataTemplate>
												<StackPanel HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Spacing="8">
													<ProgressRing AutomationProperties.AutomationId="LoadingView_ProgressRing"
																  IsActive="True"
																  Width="40"
																  Height="40" />
													<TextBlock HorizontalAlignment="Center"
															   Text="{Binding}" />
												</StackPanel>
											</DataTemplate>
										</utu:LoadingView.LoadingContentTemplate>

										<!-- Loaded content -->
										<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
												CornerRadius="8"
												Padding="16"
												MinHeight="80">
											<StackPanel Spacing="8">
												<TextBlock AutomationProperties.AutomationId="LoadingView_ResultText"
														   Style="{StaticResource BodyTextBlockStyle}"
														   Text="{Binding Data.ResultText}" />
											</StackPanel>
										</Border>
									</utu:LoadingView>

									<Button AutomationProperties.AutomationId="LoadingView_LoadButton"
											Command="{Binding Data.LoadCommand}"
											Content="Load data (2 s delay)"
											HorizontalAlignment="Center"
											Style="{StaticResource FilledButtonStyle}" />

									<ToggleSwitch x:Name="TransitionsToggle"
												  AutomationProperties.AutomationId="LoadingView_TransitionsToggle"
												  Header="UseTransitions" />
								</StackPanel>
							</smtx:XamlDisplay>

							<!-- Multi-source loading -->
							<smtx:XamlDisplay UniqueKey="LoadingViewSamplePage_MultiSource"
											  smtx:XamlDisplayExtensions.Header="LoadingView — CompositeLoadableSource (all must complete)">
								<StackPanel Spacing="12">
									<utu:LoadingView AutomationProperties.AutomationId="LoadingView_Multi"
													 LoadingContent="Refreshing…">
										<utu:LoadingView.Source>
											<utu:CompositeLoadableSource>
												<utu:LoadableSource Source="{Binding Data.LoadCommand}" />
												<utu:LoadableSource Source="{Binding Data.SlowLoadCommand}" />
											</utu:CompositeLoadableSource>
										</utu:LoadingView.Source>

										<utu:LoadingView.LoadingContentTemplate>
											<DataTemplate>
												<StackPanel HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Spacing="8">
													<ProgressBar Width="200"
																 IsIndeterminate="True" />
													<TextBlock HorizontalAlignment="Center"
															   Text="{Binding}" />
												</StackPanel>
											</DataTemplate>
										</utu:LoadingView.LoadingContentTemplate>

										<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
												CornerRadius="8"
												Padding="16"
												MinHeight="80">
											<TextBlock AutomationProperties.AutomationId="LoadingView_MultiResultText"
													   Style="{StaticResource BodyTextBlockStyle}"
													   Text="{Binding Data.SlowResultText}" />
										</Border>
									</utu:LoadingView>

									<Button AutomationProperties.AutomationId="LoadingView_ReloadAll"
											Command="{Binding Data.LoadAllCommand}"
											Content="Load All (fast 2 s + slow 4 s)"
											HorizontalAlignment="Center" />
								</StackPanel>
							</smtx:XamlDisplay>

						</StackPanel>
					</ScrollViewer>
				</DataTemplate>
			</local:SamplePageLayout.DesignAgnosticTemplate>
		</local:SamplePageLayout>
	</Grid>
</Page>
