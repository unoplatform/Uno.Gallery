<Page x:Class="Uno.Gallery.Views.Samples.SelectorBarSamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Uno.Gallery"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:smtx="using:ShowMeTheXAML"
      mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <local:SamplePageLayout x:Name="SamplePageLayoutRoot">
            <local:SamplePageLayout.FluentTemplate>
                <DataTemplate>
                    <StackPanel Spacing="12">

                        <!-- SelectorBar: text items -->
                        <smtx:XamlDisplay UniqueKey="SelectorBar_Fluent_Default"
                                          smtx:XamlDisplayExtensions.Header="SelectorBar"
                                          smtx:XamlDisplayExtensions.Description="SelectorBar provides a row of mutually exclusive items that navigate or filter content, similar to a tab strip but styled as a selection bar."
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <SelectorBar AutomationProperties.AutomationId="SelectorBar_Default"
                                             SelectionChanged="OnSelectorBarSelectionChanged">
                                    <SelectorBarItem AutomationProperties.AutomationId="SelectorBar_Item_All"
                                                     Text="All" />
                                    <SelectorBarItem AutomationProperties.AutomationId="SelectorBar_Item_Unread"
                                                     Text="Unread" />
                                    <SelectorBarItem Text="Flagged" />
                                    <SelectorBarItem Text="Urgent" />
                                </SelectorBar>

                                <TextBlock x:Name="SelectorBarResult"
                                           AutomationProperties.AutomationId="SelectorBar_Result"
                                           Text="Selected: All"
                                           Style="{StaticResource BodyMedium}" />
                            </StackPanel>
                        </smtx:XamlDisplay>

                        <!-- SelectorBar: icon + text items -->
                        <smtx:XamlDisplay UniqueKey="SelectorBar_Fluent_WithIcons"
                                          smtx:XamlDisplayExtensions.Header="SelectorBar — with icons"
                                          smtx:XamlDisplayExtensions.IgnorePath="XamlDisplay\StackPanel">
                            <StackPanel Spacing="8">
                                <SelectorBar AutomationProperties.AutomationId="SelectorBar_Icons">
                                    <SelectorBarItem Text="Home">
                                        <SelectorBarItem.Icon>
                                            <SymbolIcon Symbol="Home" />
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem Text="Mail">
                                        <SelectorBarItem.Icon>
                                            <SymbolIcon Symbol="Mail" />
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem Text="Calendar">
                                        <SelectorBarItem.Icon>
                                            <SymbolIcon Symbol="Calendar" />
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem Text="Contacts">
                                        <SelectorBarItem.Icon>
                                            <SymbolIcon Symbol="People" />
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                </SelectorBar>
                            </StackPanel>
                        </smtx:XamlDisplay>

                    </StackPanel>
                </DataTemplate>
            </local:SamplePageLayout.FluentTemplate>
        </local:SamplePageLayout>
    </Grid>
</Page>
