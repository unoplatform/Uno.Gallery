{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallery.platform.uno/schemas/feature-coverage-v1.json",
  "title": "Uno Gallery feature coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "disposition",
          "gallerySlugs",
          "owner",
          "issue",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "disposition": {
            "enum": [
              "covered-core",
              "optional-flavor",
              "external-companion",
              "docs-only",
              "not-applicable",
              "blocked"
            ]
          },
          "gallerySlugs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
