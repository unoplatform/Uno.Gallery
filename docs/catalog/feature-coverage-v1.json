    {
      "id": "system-backdrop",
      "disposition": "optional-flavor",
      "gallerySlugs": [],
      "owner": "unoplatform",
      "issue": null,
      "reason": "The windows-backdrops page is emitted only in the Windows platform catalog and applies supported Mica or Desktop Acrylic to the existing Gallery window, clearing it on unload; cross-target fixture comparison cannot reference a platform-only slug."
    },
    {
