{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallery.platform.uno/schemas/upstream-feature-manifest-v1.json",
  "title": "Uno upstream feature manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "complete",
    "sources",
    "features"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "pinned-fixture",
        "authoritative"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "commit"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^unoplatform/[A-Za-z0-9._-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "name",
          "status",
          "package",
          "minimalSamplePath",
          "documentation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "repository": {
            "type": "string",
            "pattern": "^unoplatform/[A-Za-z0-9._-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "stable",
              "preview",
              "experimental",
              "deprecated"
            ]
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "minimalSamplePath": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
