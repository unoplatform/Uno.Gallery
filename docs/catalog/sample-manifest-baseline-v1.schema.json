{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gallery.platform.uno/schemas/sample-manifest-baseline-v1.json",
  "title": "Uno Gallery sample manifest baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimumSampleCount",
          "requiredSlugs"
        ],
        "properties": {
          "minimumSampleCount": {
            "type": "integer",
            "minimum": 1
          },
          "requiredSlugs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  }
}
